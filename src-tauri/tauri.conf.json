{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glagolitic Converter",
  "version": "1.0.0",
  "identifier": "com.glagolitic.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Glagolitic Converter",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Visible",
        "hiddenTitle": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "Utility",
    "shortDescription": "Convert between Latin and Glagolitic scripts",
    "longDescription": "A beautiful, native application for converting text between Latin and Glagolitic scripts with real-time conversion, keyboard shortcuts, and a modern liquid glass interface.",
    "copyright": "MIT License",
    "resources": [],
    "externalBin": [],
    "createUpdaterArtifacts": true,
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": null,
      "hardenedRuntime": true
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": null,
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [],
        "section": "utils"
      },
      "rpm": {
        "depends": [],
        "release": "1"
      },
      "appimage": {}
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
